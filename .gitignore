# Environment
.venv/
__pycache__/
*.pyc
.DS_Store
.claude/

# Regenerable artefacts (see README: scripts/ rebuild all of these)
data/
features/
logs/
models/**/*.pt
models/**/*.pkl
results/**/*.png
*.zip

# LaTeX build output
report/*.aux
report/*.log
report/*.out
report/*.bbl
report/*.blg
report/*.pdf

# Private documents (your own certificates): never committed
private/
# Per-word reading logs of the real datasets (large, regenerable)
results/real/*_reads_*.json

# Final report build output and the extracted template parts (rebuilt by scripts/build_report.py)
report/final_report/CVP_Final_Report.docx
report/final_report/template_parts/
